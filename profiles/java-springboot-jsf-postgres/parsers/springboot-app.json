{
  "parser_version": "0.1.0",
  "source": "springboot",
  "description": "Log de una aplicacion Spring Boot 1.5 con el layout por defecto de logback. El patron esta tomado de la propiedad FILE_LOG_PATTERN de org/springframework/boot/logging/logback/defaults.xml dentro de spring-boot-1.5.2.RELEASE.jar: '%d{yyyy-MM-dd HH:mm:ss.SSS} %5p ${PID} --- [%t] %-40.40logger{39} : %m%n%wEx'. Aplica cuando la aplicacion no trae logback.xml propio.",
  "line_pattern": "^(?P<timestamp>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{3})\\s+(?P<severity>[A-Z]+)\\s+(?P<pid>\\d+)?\\s*---\\s+\\[(?P<thread>[^\\]]*)\\]\\s+(?P<logger>\\S+)\\s+:\\s(?P<message>.*)$",
  "timestamp": { "group": "timestamp", "format": "%Y-%m-%d %H:%M:%S.%f" },
  "fields": {
    "component": { "from": "logger", "transform": "last_segment" },
    "message": { "from": "message" },
    "severity": {
      "from": "severity",
      "map": { "TRACE": "debug", "DEBUG": "debug", "INFO": "info", "WARN": "warn", "ERROR": "error", "FATAL": "fatal" },
      "default": "info"
    },
    "metadata.thread": { "from": "thread", "transform": "strip" },
    "metadata.pid": { "from": "pid" },
    "metadata.logger": { "from": "logger" }
  },
  "event_type": {
    "default": "log",
    "rules": [
      { "when": { "field": "logger", "matches": "^org\\.hibernate\\.SQL$" }, "value": "sql" },
      { "when": { "field": "message", "matches": "Exception|APPLICATION FAILED TO START" }, "value": "exception" }
    ]
  },
  "continuation": { "pattern": "^(\\s+at |Caused by: |\\s+Suppressed: |\\s+\\.\\.\\. \\d+ more|\\t)" },
  "affinity": ["thread"]
}
