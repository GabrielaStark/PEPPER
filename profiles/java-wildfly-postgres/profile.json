{
  "schema_version": "0.1.0",
  "id": "java-wildfly-postgres",
  "name": "Java EE sobre WildFly con PostgreSQL",
  "version": "0.1.0",
  "status": "draft",
  "stack": {
    "languages": [
      "java"
    ],
    "frameworks": [
      "java-ee"
    ],
    "servers": [
      "wildfly"
    ],
    "databases": [
      "postgresql"
    ]
  },
  "detection": {
    "signals": [
      {
        "type": "extension",
        "pattern": "*.war",
        "weight": 2
      },
      {
        "type": "file_exists",
        "pattern": "pom.xml",
        "weight": 1
      },
      {
        "type": "file_exists",
        "pattern": "standalone*.xml",
        "weight": 3
      },
      {
        "type": "file_content",
        "file": "standalone*.xml",
        "pattern": "urn:jboss:domain",
        "weight": 3,
        "required": true
      },
      {
        "type": "file_content",
        "file": "**/*.properties",
        "pattern": "jdbc:postgresql",
        "weight": 2
      },
      {
        "type": "extension",
        "pattern": "*.dump",
        "weight": 1
      }
    ],
    "min_score": 4
  },
  "rehydrate": {
    "required_inputs": [
      "artefacto desplegable (.war o código fuente compilable con pom.xml)",
      "respaldo o esquema de la base de datos (.dump/.sql)",
      "configuración de datasource (standalone.xml o properties)"
    ],
    "optional_inputs": [
      "properties del ambiente original",
      "certificados",
      "scripts de arranque del servidor original"
    ],
    "compose_template": "compose.template.yml",
    "database": {
      "engine": "postgresql",
      "default_port": 5432,
      "images": {
        "*": "postgres:{major}"
      },
      "dump": {
        "format": "pg_dump_custom",
        "suffixes": [
          ".dump",
          ".backup"
        ]
      },
      "localhost": "blocked",
      "probe": {
        "service": "db",
        "client": [
          "psql",
          "-U",
          "{db_user}",
          "-d",
          "{db_name}",
          "-Atc",
          "{sql}"
        ],
        "quiet_prefix": "SET log_statement = 'none'; ",
        "ready_sql": "select 1",
        "tables_sql": "select count(*) from pg_tables where schemaname not in ('pg_catalog','information_schema')",
        "marker_sql": "select shobj_description((select oid from pg_database where datname = current_database()), 'pg_database')",
        "foreign_servers_sql": "select string_agg(srvname||'→'||coalesce((select option_value from pg_options_to_table(srvoptions) where option_name='host'),'?'),', ') from pg_foreign_server",
        "restore_ok_status": [
          0,
          1
        ]
      }
    },
    "datasource": {
      "mechanism": "xml",
      "files": [
        "standalone*.xml",
        "configuration/standalone*.xml",
        "*-ds.xml"
      ],
      "keys": {
        "url": "//datasources/datasource/connection-url",
        "user": "//datasources/datasource/security/user-name",
        "password": "//datasources/datasource/security/password"
      }
    }
  },
  "collectors": [
    {
      "source": "wildfly",
      "parser": "parsers/wildfly-server-log.json"
    },
    {
      "source": "postgresql",
      "parser": "parsers/postgresql-log.json"
    }
  ],
  "notes": "Parsers probados contra la evidencia sintética de examples/legacy-demo. Falta: compose.template.yml y ejecutar la receta de rehydrate contra el legacy-demo real. Al validarse, cambiar status a validated."
}
